<?xml version="1.0"?>
<package format="3">
  <name>woki_step_detector</name>
  <version>0.0.1</version>
  <description>WoKi D435 two-boundary step height detector ROS2 node</description>

  <maintainer email="woki@example.com">woki</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pyrealsense2-pip</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
